# Copy to .env and adjust. Never commit .env.
# The server only ever binds to a loopback address.
NEWS_HOST=127.0.0.1
NEWS_PORT=8765

# Refresh cadence (minutes) and behaviour
NEWS_SCAN_INTERVAL_MINUTES=15
NEWS_SCAN_ON_STARTUP=true
NEWS_DEMO_ENABLED=false
NEWS_DISPLAY_TIMEZONE=Europe/Bucharest
NEWS_LOG_LEVEL=INFO

# Contact info appended to the User-Agent. Some publishers (e.g. SEC) require it.
# Leave empty to keep those sources disabled.
NEWS_CONTACT=

# --- Licensed sources (private URLs and credentials; referenced by name in sources.yaml) ---
# Reuters Connect (your contract's API endpoint + token)
REUTERS_CONNECT_API_URL=
REUTERS_CONNECT_ACCESS_TOKEN=
# Financial Times licensed API
FT_API_URL=
FT_API_KEY=
# Any other licensed/syndication RSS feed (e.g. a publisher feed included in your licence)
LICENSED_RSS_1_URL=
