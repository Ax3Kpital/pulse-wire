<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent: starts the news aggregator backend (127.0.0.1 only) when you log in.
  Rendered by scripts/launchagent.sh install (replaces __REPO__). The browser is not involved:
  open http://127.0.0.1:8765 whenever you like.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.news-aggregator</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>app</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/backend</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.err.log</string>
</dict>
</plist>
